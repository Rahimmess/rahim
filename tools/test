#!/usr/bin/env python3
"""Run the OpenWalls test suite.

With a native ruby on PATH this is simply `ruby test/run.rb`.

Without one, the repo falls back to the bundled ruby.wasm interpreter (see
tools/ruby). That interpreter segfaults non-deterministically once a process
has allocated enough -- a bug in ruby.wasm's GC under Node's WASI, not in the
code under test -- so here we run one test group per process and retry a
crashed shard. A shard that keeps crashing is reported separately from a
failing test and still fails the run, so a crash can never be mistaken for a
pass.

    tools/test                 # everything
    tools/test openings        # only groups whose name matches
"""
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RETRIES = 16
SEGFAULT = -11

GREEN, RED, YELLOW, DIM, OFF = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"
SUMMARY = re.compile(r"^\s+(\d+) tests, (\d+) failures, (\d+) errors")


def discover(test_dir):
    """[(group, [test name, ...]), ...] in source order."""
    groups = []
    for name in sorted(os.listdir(test_dir)):
        if not (name.startswith("test_") and name.endswith(".rb")):
            continue
        with open(os.path.join(test_dir, name), encoding="utf-8") as handle:
            for line in handle:
                match = re.match(r"^group ['\"](.+?)['\"] do", line)
                if match:
                    groups.append((match.group(1), []))
                    continue
                match = re.match(r"^\s+test ['\"](.+?)['\"] do", line)
                if match and groups:
                    groups[-1][1].append(match.group(1))
    return groups


def run_filter(expr):
    """Runs one shard, retrying host-interpreter crashes."""
    for _ in range(RETRIES):
        proc = subprocess.run(
            [os.path.join(ROOT, "tools", "ruby"), "test/run.rb", expr],
            cwd=ROOT, capture_output=True, text=True,
        )
        if proc.returncode != SEGFAULT:
            return proc.returncode, proc.stdout + proc.stderr
    return SEGFAULT, ""


def tally(output):
    counts = [0, 0, 0]
    for line in output.splitlines():
        match = SUMMARY.match(line)
        if match:
            counts = [a + b for a, b in zip(counts, (int(x) for x in match.groups()))]
    return counts


def run_shard(group, tests):
    """A whole group in one process, falling back to one process per test.

    The heavier groups allocate enough to trip the ruby.wasm GC bug every
    time; splitting them down to a single test per process keeps each run
    small enough to survive.
    """
    code, output = run_filter(group)
    if code != SEGFAULT:
        return code, output, False

    merged = []
    worst = 0
    for name in tests:
        code, output = run_filter(name)
        if code == SEGFAULT:
            return SEGFAULT, "\n".join(merged), True
        merged.append(output)
        worst = max(worst, code)
    return worst, "\n".join(merged), True


def main():
    wanted = sys.argv[1] if len(sys.argv) > 1 else None

    if shutil.which("ruby"):
        return subprocess.run(
            ["ruby", "test/run.rb"] + ([wanted] if wanted else []), cwd=ROOT
        ).returncode

    groups = discover(os.path.join(ROOT, "test"))
    if wanted:
        groups = [g for g in groups if wanted.lower() in g[0].lower()]
    if not groups:
        print(f"no test groups matched {wanted!r}", file=sys.stderr)
        return 1

    totals = [0, 0, 0]
    crashed = []
    print()
    for group, tests in groups:
        code, output, split = run_shard(group, tests)
        if code == SEGFAULT:
            crashed.append(group)
            print(f"{YELLOW}  !!  {group:<36} host interpreter crashed {RETRIES}x{OFF}")
            continue

        counts = tally(output)
        totals = [a + b for a, b in zip(totals, counts)]
        note = f"{DIM} (one process per test){OFF}" if split else ""

        if counts[1] or counts[2]:
            print(f"{RED}  FAIL{OFF} {group:<36} "
                  f"{counts[0]} tests, {counts[1]} failures, {counts[2]} errors")
            show = False
            for line in output.splitlines():
                if re.match(r"^\s+[\u2717!] ", line):
                    show = True
                elif re.match(r"^\s+\u2713 ", line):
                    show = False
                if show:
                    print("       " + line.strip())
        else:
            print(f"{GREEN}  ok  {OFF}{group:<36} {DIM}{counts[0]} tests{OFF}{note}")

    print()
    line = f"  {totals[0]} tests, {totals[1]} failures, {totals[2]} errors"
    if crashed:
        line += f", {len(crashed)} crashed shard(s)"
    print(line + "\n")
    return 0 if not (totals[1] or totals[2] or crashed) else 1


if __name__ == "__main__":
    sys.exit(main())
